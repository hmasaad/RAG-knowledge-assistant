# openai calls the OpenAI API. local runs retrieval and answers without a key.
# The local embedder and answerer are for tests and demos, not production quality.
EMBEDDING_PROVIDER=local
LLM_PROVIDER=local
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

CHROMA_PATH=data/chroma
SQLITE_PATH=data/metadata.db
COLLECTION_NAME=knowledge

CHUNK_SIZE=800
CHUNK_OVERLAP=120
# structure keeps markdown headings. fixed, recursive, and semantic are the other splitters.
CHUNK_STRATEGY=structure
SEMANTIC_SIMILARITY=0.35
MAX_UPLOAD_BYTES=10485760
DEFAULT_USER_ID=local
BLOB_PATH=data/blobs
# Leave CHROMA_HOST empty to store vectors in CHROMA_PATH.
# Set it when the API and the worker are separate processes.
CHROMA_HOST=
CHROMA_PORT=8000
# inline indexes and finishes a research cycle in the request.
# background queues indexing and research cycles for the worker.
INDEXING_MODE=inline
WORKER_IN_PROCESS=true
WORKER_POLL_SECONDS=1
JOB_TIMEOUT_SECONDS=900
EMBEDDING_CACHE_SIZE=4096
ANSWER_CACHE_SIZE=256
# coverage reranks by question-term overlap.
# cross_encoder scores each query and passage together.
# api posts the candidates to a Cohere-compatible rerank endpoint.
RERANK_PROVIDER=coverage
RERANK_MODEL=
RERANK_API_URL=
RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=15
QUERY_REWRITE=false
QUERY_DECOMPOSE=false
MULTI_QUERY=false
PARENT_RETRIEVAL=false
CHILD_CHUNK_SIZE=240
CONTEXTUAL_RETRIEVAL=false
KNOWLEDGE_GRAPH=false
AGENT_ENABLED=true
RESEARCH_SEARCH_BUDGET=16
RESEARCH_MAX_COST=0
RESEARCH_DENIED_TOOLS=
RESEARCH_DENIED_ACTIONS=
RESEARCH_TIMEOUT_SECONDS=30
RESEARCH_ADAPT_ROUNDS=2
RESEARCH_WORKER_CONCURRENCY=2
RESEARCH_TASK_CONCURRENCY=2
RESEARCH_USER_CONCURRENCY=2
GOVERNANCE_HOLD=false
GOVERNANCE_REQUIRE_APPROVAL=true
GOVERNANCE_OPERATORS=
LOG_LEVEL=INFO
