# openai calls the OpenAI API. local runs retrieval and answers without a key.
# The local embedder and answerer are for tests and demos, not production quality.
EMBEDDING_PROVIDER=openai
LLM_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

CHROMA_PATH=data/chroma
SQLITE_PATH=data/metadata.db
COLLECTION_NAME=knowledge

CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_BYTES=10485760
DEFAULT_USER_ID=local
BLOB_PATH=data/blobs
# Leave CHROMA_HOST empty to store vectors in CHROMA_PATH.
# Set it when the API and the worker are separate processes.
CHROMA_HOST=
CHROMA_PORT=8000
# inline indexes inside the request. background queues the work.
INDEXING_MODE=inline
WORKER_IN_PROCESS=true
WORKER_POLL_SECONDS=1
JOB_TIMEOUT_SECONDS=900
EMBEDDING_CACHE_SIZE=4096
ANSWER_CACHE_SIZE=256
LOG_LEVEL=INFO
