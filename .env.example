# openai uses the OpenAI embeddings API. local is an offline hashed embedder
# for tests and demos; it is not a production embedding model.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

CHROMA_PATH=data/chroma
SQLITE_PATH=data/metadata.db
COLLECTION_NAME=knowledge

CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO
